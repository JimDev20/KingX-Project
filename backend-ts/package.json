{
  "name": "backend-ts",
  "version": "1.0.0",
  "description": "KingX Uptime Monitor Backend",
  "main": "src/server.ts",
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
